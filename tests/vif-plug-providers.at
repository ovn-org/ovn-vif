AT_CHECK([ovstest test-vif-plug-representor port-prepare-remove vf], [0], [])
AT_CHECK([
    ovstest test-vif-plug-representor port-prepare-remove foreign-bridge],
    [0], [])
AT_CHECK([ovstest test-vif-plug-representor port-prepare-remove empty-bridge],
         [0], [])
AT_CHECK([
    ovstest test-vif-plug-representor port-prepare-remove unknown-interface],
    [0], [])
AT_CLEANUP

AT_SETUP([representor unplug incomplete context])
AT_CHECK([ovstest test-vif-plug-representor port-prepare-remove no-bridge],
         [0], [])
AT_CHECK([ovstest test-vif-plug-representor port-prepare-remove no-interface],
         [0], [])
AT_CHECK([
    ovstest test-vif-plug-representor port-prepare-remove empty-interface],
